**FREE
/********************************************************************/
/* Program : CABSHIFT                                               */
/* Purpose : Demonstrate Compile Time, Pre-Run Time and Run Time    */
/*           Arrays in HEXA CAB system                              */
/********************************************************************/

ctl-opt dftactgrp(*no) actgrp(*caller);

/*------------------------------------------------------------------*/
/* File                                                             */
/*------------------------------------------------------------------*/
dcl-f EMPMAST usage(*input) keyed;

/*------------------------------------------------------------------*/
/* Compile Time Array (Cab Types)                                   */
/*------------------------------------------------------------------*/
dcl-s CabType char(10) dim(3) ctdata;

/*------------------------------------------------------------------*/
/* Pre-Run Time Array (Shift Pickup Times)                          */
/*------------------------------------------------------------------*/
dcl-s ShiftTime char(8) dim(3) perrcd(1);

/*------------------------------------------------------------------*/
/* Run Time Array (Employee IDs from file)                          */
/*------------------------------------------------------------------*/
dcl-s EmpArray packed(6:0) dim(10);
dcl-s idx int(5) inz(1);

/*------------------------------------------------------------------*/
/* Variables                                                        */
/*------------------------------------------------------------------*/
dcl-s empId packed(6:0);

/*------------------------------------------------------------------*/
/* Load Run Time Array from File                                    */
/*------------------------------------------------------------------*/

setll *loval EMPMAST;

dow idx <= 10;

   read EMPMAST;

   if %eof(EMPMAST);
      leave;
   endif;

   EmpArray(idx) = EMPID;
   idx += 1;

enddo;

/*------------------------------------------------------------------*/
/* Display Compile Time Array                                       */
/*------------------------------------------------------------------*/

dsply '--- CAB TYPES ---';

for idx = 1 to %elem(CabType);

   dsply CabType(idx);

endfor;

/*------------------------------------------------------------------*/
/* Display Pre-Run Time Array                                       */
/*------------------------------------------------------------------*/

dsply '--- SHIFT TIMES ---';

for idx = 1 to %elem(ShiftTime);

   dsply ShiftTime(idx);

endfor;

/*------------------------------------------------------------------*/
/* Display Run Time Array                                           */
/*------------------------------------------------------------------*/

dsply '--- EMPLOYEE LIST ---';

for idx = 1 to %elem(EmpArray);

   if EmpArray(idx) = 0;
      leave;
   endif;

   dsply EmpArray(idx);

endfor;

/*------------------------------------------------------------------*/
*inlr = *on;
return;

/********************************************************************/
/* Compile Time Data                                                */
/********************************************************************/
**CTDATA
SEDAN
SUV
MINI
